# PICO backend — placeholders only. Never commit real values.
NODE_ENV=development
PORT=4242
DATABASE_PATH=./data/pico.sqlite
# Stripe TEST mode keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Supplier adapter: mock | real (Sprint 2)
SUPPLIER_ADAPTER=mock
# Session signing
SESSION_SECRET=replace_with_random_32_bytes
# Ops/admin endpoints (required in production, dev default otherwise)
ADMIN_TOKEN=replace_with_random_32_bytes
# Pricing engine (V2 §44): never sell below cost*(1+floor)
PICO_MIN_MARGIN_PCT=0.10
# Referral abuse caps (V2 §46)
REFERRAL_DISCOUNT_CENTS=500
REFERRAL_MAX_CREDIT_CENTS=2500
# Emergency kill switches — set any to 'off' to disable without redeploy:
# PICO_FLAG_ESIM_FR_ENABLED=off  PICO_FLAG_SUPPLIER_MOCK_ENABLED=off
# Environments (V2 §32): keep a separate .env per environment —
# .env.local / .env.test / .env.staging / .env.production — never mix
# production keys, data, or money into non-production environments.
